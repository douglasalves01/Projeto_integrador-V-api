# ===== Database (compartilhado) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=streaming_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/streaming_db

# ===== API (apps/api) =====
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
APP_NAME=Streaming Recommendation API
DEBUG=true
AI_SERVICE_URL=http://localhost:8002/api/v1
AI_SERVICE_API_KEY=
AI_ENABLED=true
AI_CHAT_TIMEOUT_SEC=20
AI_ENCODE_TIMEOUT_SEC=5
REDIS_URL=redis://localhost:6379/0
RECS_CACHE_TTL=300
SEMANTIC_SEARCH_ENABLED=true
CHAT_VODCHAT_TIMEOUT_SEC=20
CHAT_VIDEO_SEARCH_TIMEOUT_SEC=8

# ===== IA (apps/ai) =====
JWT_SECRET=change-me-in-production   # mesmo SECRET_KEY da API
AI_API_KEY=change-me-ai-api-key
REDIS_URL=redis://localhost:6379/0
VODREC_MODEL_PATH=apps/ai/models/vodrec/model.pt
VODREC_VOCAB_PATH=apps/ai/models/vodrec/vocab.json
VODCHAT_ADAPTER_PATH=apps/ai/models/vodchat/vodchat-lora-final
VODCHAT_BASE_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
LLM_ENABLED=true
VODCHAT_ENABLED=false
# Respostas do chat (default 160; antes era 40 no codigo)
VODCHAT_MAX_NEW_TOKENS=160
VODCHAT_MAX_TIME_SECONDS=20

# ===== Analytics (apps/analytics) =====
REPORTS_DIR=apps/analytics/reports
